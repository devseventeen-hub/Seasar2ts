{
  "name": "seasar2ts-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Seasar2 / S2Dao regeneration framework and Java to TypeScript converter",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
